rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid == 'SRx2kZD2jzdM3Q6RVVOjioAuHuw1'; }
    function approved() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/snookerAccess/$(request.auth.uid)) && get(/databases/$(database)/documents/snookerAccess/$(request.auth.uid)).data.status == 'approved');
    }
    function normalAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    match /privateSnooker/{userId} {
      allow read, write: if approved() && request.auth.uid == userId;
    }
    // Single-use 128-bit invitations. Claim is bound atomically to one
    // anonymous Firebase Auth UID; only the same device can reconnect.
    match /snookerTableInvites/{token} {
      function validToken() { return token.matches('^[a-f0-9]{32}$'); }
      function boardPath(owner,slot) {
        return /databases/$(database)/documents/snookerTableBoards/$(owner)/tables/$(string(slot));
      }
      allow get: if signedIn();
      allow list: if false;
      allow create: if normalAccount()
        && approved() && request.resource.data.owner == request.auth.uid
        && validToken()
        && request.resource.data.keys().hasOnly(['owner','slot','tournamentKey'])
        && request.resource.data.slot is int
        && request.resource.data.slot >= 1 && request.resource.data.slot <= 6;
      allow update: if signedIn() && validToken()
        && !('claimedBy' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy'])
        && request.resource.data.claimedBy == request.auth.uid
        && exists(boardPath(resource.data.owner,resource.data.slot))
        && get(boardPath(resource.data.owner,resource.data.slot)).data.joinToken == token
        && get(boardPath(resource.data.owner,resource.data.slot)).data.joinOpen == true
                && get(boardPath(resource.data.owner,resource.data.slot)).data.tournamentKey == resource.data.tournamentKey;
      allow delete: if approved() && normalAccount() && resource.data.owner == request.auth.uid;
    }
    match /snookerTableBoards/{organizer}/tables/{slot} {
      function isOwner() { return approved() && normalAccount() && request.auth.uid == organizer; }
      function isMember() {
        return signedIn()
          && exists(/databases/$(database)/documents/snookerTableBoards/$(organizer)/tables/$(slot)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/snookerTableBoards/$(organizer)/tables/$(slot)/members/$(request.auth.uid)).data.token == resource.data.joinToken
          && exists(/databases/$(database)/documents/snookerTableInvites/$(resource.data.joinToken))
          && get(/databases/$(database)/documents/snookerTableInvites/$(resource.data.joinToken)).data.claimedBy == request.auth.uid;
      }
      function validScoreState() {
        let state = request.resource.data.state;
        return state.keys().hasAll(['events','cursor','revision'])
          && state.keys().hasOnly(['events','cursor','revision'])
          && state.events is list && state.events.size() <= 2000
          && state.cursor is int && state.cursor >= 0 && state.cursor <= state.events.size()
          && state.revision is int && state.revision == resource.data.state.revision + 1;
      }
      allow get: if isOwner() || isMember();
      allow list: if isOwner();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (isMember()
        && resource.data.enabled == true && resource.data.joinOpen == true
        && resource.data.assignment != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state'])
        && validScoreState());
      match /members/{member} {
        function validJoin() {
          let token = request.resource.data.token;
          let board = get(/databases/$(database)/documents/snookerTableBoards/$(organizer)/tables/$(slot)).data;
          let invite = get(/databases/$(database)/documents/snookerTableInvites/$(token)).data;
          return token is string && token.matches('^[a-f0-9]{32}$')
            && request.resource.data.keys().hasOnly(['token'])
            && board.joinOpen == true && board.joinToken == token
            && invite.owner == organizer && string(invite.slot) == slot
            && invite.tournamentKey == board.tournamentKey
            && getAfter(/databases/$(database)/documents/snookerTableInvites/$(token)).data.claimedBy == request.auth.uid;
        }
        allow get: if signedIn() && (request.auth.uid == member || request.auth.uid == organizer);
        allow list: if normalAccount() && request.auth.uid == organizer;
        allow create, update: if signedIn() && request.auth.uid == member && validJoin();
        allow delete: if signedIn() && (request.auth.uid == member || request.auth.uid == organizer);
      }
    }

    // Einmalige Freigabe pro Firebase UID; Benutzer dürfen nur Antrag anlegen.
    match /snookerAccess/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['email','status','createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    // Push-Abonnements darf nur der Administrator selbst anlegen und lesen.
    match /snookerAdminPush/{uid}/subscriptions/{subscriptionId} {
      allow read, create, update, delete: if isAdmin() && request.auth.uid == uid;
    }
    // Existing operator access, keeping private Snooker accounts separated.
    match /{collection}/{document=**} {
      allow read, write: if signedIn()
        && request.auth.uid == 'SRx2kZD2jzdM3Q6RVVOjioAuHuw1'
        && collection != 'privateSnooker'
        && collection != 'snookerTableInvites'
        && collection != 'snookerTableBoards'
        && collection != 'snookerAccess'
        && collection != 'snookerAdminPush';
    }
    // Existing Pool group access.
    match /privatePool/SRx2kZD2jzdM3Q6RVVOjioAuHuw1 {
      allow read, write: if signedIn()
        && request.auth.uid == 'FZZLq71H5lVXNNDnfRS6URdaODs2';
    }
  }
}
